# URL base de la API, incluyendo el sufijo /api (los servicios usan paths
# relativos como /auth/login, /products, ...). Convención de Create React App:
# las variables públicas deben empezar con REACT_APP_ y se incrustan en el
# build. Si esta URL cambia hay que reconstruir y redeployar el frontend.
#
# Local:      http://localhost:4000/api
# Producción: https://mi-api.onrender.com/api
REACT_APP_API_URL=http://localhost:4000/api